# Copy this file to .env and fill in the keys you have. Every key is optional:
# without keys the tool still runs free local checks (syntax, disposable domains,
# mail-server DNS, phone numbering plan). Use --mock to try it with fake providers.

# --- Provider keys ---------------------------------------------------------
# Hunter.io Email Verifier  https://hunter.io/api-keys
HUNTER_API_KEY=
# Abstract API has a separate key per product  https://app.abstractapi.com/
ABSTRACT_EMAIL_API_KEY=
ABSTRACT_PHONE_API_KEY=

# --- Behaviour -------------------------------------------------------------
# live | mock
ENRICH_MODE=live
# Country used for phone numbers written without +code (ISO-2: US, GB, AE, DE...)
DEFAULT_COUNTRY=US
# waterfall (Hunter, then Abstract only if unsure) | consensus (both) | hunter | abstract
EMAIL_STRATEGY=waterfall
CHECK_MX=true
CONCURRENCY=5

# --- Campaign policy -------------------------------------------------------
# Put catch-all / risky emails into the email channel?
ALLOW_RISKY_EMAIL=false
ALLOW_FREE_EMAIL=true
ALLOW_ROLE_EMAIL=true
SMS_LINE_TYPES=mobile
CALL_LINE_TYPES=mobile,landline,landline_or_mobile,voip

# --- Cache (saves credits on repeat lookups) -------------------------------
CACHE_ENABLED=true
CACHE_FILE=.cache/enrichment-cache.json
CACHE_TTL_HOURS=720

# --- Rate limits / HTTP ----------------------------------------------------
# Abstract free plan allows 1 request per second
ABSTRACT_MIN_INTERVAL_MS=1000
HUNTER_MIN_INTERVAL_MS=70
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=3

# --- REST service ----------------------------------------------------------
PORT=3000
# If set, every /v1 request must send it in the x-api-key header
SERVICE_API_KEY=
MAX_BATCH_SIZE=500
LOG_LEVEL=info
